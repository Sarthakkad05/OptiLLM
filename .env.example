# =============================================================================
# OptiLLM Gateway — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── 1. CORE APPLICATION & ENVIRONMENT ─────────────────────────────────────────
APP_ENV=development                       # development | production
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
PROJECT_NAME=OptiLLM

# Database — SQLite for zero-config local dev; PostgreSQL for production:
DATABASE_URL=sqlite:///./optillm.db
# DATABASE_URL=postgresql://optillm:password@localhost:5432/optillmdb

# ── 2. PRIMARY LLM PROVIDERS ──────────────────────────────────────────────────
# Set at least one provider key below (or leave blank to use mock responses in dev)
OPENAI_API_KEY=                           # sk-proj-...
ANTHROPIC_API_KEY=                        # sk-ant-...
GEMINI_API_KEY=                           # AI... from Google AI Studio
OLLAMA_BASE_URL=http://localhost:11434    # Local / self-hosted Ollama server

# Default Provider & Model
DEFAULT_PROVIDER=openai                   # openai | gemini | anthropic | ollama
DEFAULT_MODEL=gpt-4o                      # Default model when not specified in request
REQUEST_TIMEOUT_SECONDS=60.0              # Global request timeout

# ── 3. EXTENDED PROVIDERS (OPTIONAL) ──────────────────────────────────────────
GROQ_API_KEY=                             # gsk_...
AZURE_OPENAI_API_KEY=                     # Azure OpenAI secret key
AZURE_OPENAI_ENDPOINT=                    # e.g. https://my-azure.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-01
MISTRAL_API_KEY=                          # Mistral AI API key
AWS_ACCESS_KEY_ID=                        # AWS Bedrock Access Key
AWS_SECRET_ACCESS_KEY=                    # AWS Bedrock Secret Key
AWS_REGION=us-east-1

# ── 4. SEMANTIC CACHE & STORAGE ───────────────────────────────────────────────
# Distributed Redis Cache (leave empty for local FAISS-only semantic cache)
REDIS_URL=                                # e.g. redis://localhost:6379/0
CACHE_TTL_SECONDS=86400                   # 24 hours
CACHE_NAMESPACE=default                   # Cache isolation partition
CACHE_SIMILARITY_THRESHOLD=0.90           # Cosine similarity cutoff (0.80 - 0.95)
FAISS_INDEX_PATH=faiss_store/index.faiss  # On-disk FAISS index persistence path

# ── 5. INTELLIGENT ROUTING & ONLINE RETRAINING ────────────────────────────────
ROUTING_STRATEGY=cost_optimized          # cost_optimized | round_robin | least_latency
ROUTING_MODE=shadow                      # rule_based | ai | shadow (logs disagreements)
AI_ROUTER_CONFIDENCE_THRESHOLD=0.70      # Confidence cutoff for AI model routing
AI_ROUTER_MODEL_PATH=ai_router.joblib    # Local router classifier weights

# Online Learning Loop (Auto-retraining on production feedback)
ROUTER_AUTO_RETRAIN=true                 # Automatically retrain router on new traffic
ROUTER_RETRAIN_INTERVAL_REQUESTS=1000     # Retrain trigger interval in requests
ROUTER_MIN_TRAINING_SAMPLES=30           # Minimum labeled samples needed to retrain

# Circuit Breaker Protection
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3      # Consecutive failures before tripping OPEN
CIRCUIT_BREAKER_RECOVERY_TIME=30.0       # Cooldown in seconds before test probes

# ── 6. EVALUATION ENGINE & QUALITY JUDGE ──────────────────────────────────────
EVAL_ENABLED=true                         # Run heuristic quality eval on requests
EVAL_LLM_ENABLED=false                    # Enable LLM-as-judge (costs ~$0.0001/eval)
EVAL_SAMPLE_RATE=0.05                     # Fraction of requests scored by LLM judge (0.05 = 5%)
EVAL_LLM_MODEL=gpt-4o-mini                # Cheap, high-capability model for evaluation

# ── 7. SECURITY, RATE LIMITS & INPUT LIMITS ───────────────────────────────────
API_KEY_AUTH_ENABLED=false                # Enforce Bearer API key check (true in prod)
OPTILLM_API_KEYS=sk-optillm-dev-key       # Comma-separated allowed dev API keys
RATE_LIMIT_PER_MINUTE=60                  # Global default requests per minute
TPM_LIMIT_PER_KEY=100000                  # Global default tokens per minute per key
CORS_ORIGINS=*                            # Allowed CORS origins or "*"
ALLOWED_PROVIDERS=openai,gemini,anthropic,ollama,groq,azure,mistral,bedrock
ALLOWED_MODELS=*                          # Allowed models list or "*"

# Input Size & OOM Protection
MAX_REQUEST_BYTES=1048576                 # 1 MB max raw request body size
MAX_MESSAGES_PER_REQUEST=200              # Max message turns in a single chat request
MAX_PROMPT_LENGTH=500000                  # Max character length for completion prompts

# Guardrails
GUARDRAILS_ENABLED=true
GUARDRAIL_PII_ENABLED=true
GUARDRAIL_CONTENT_SAFETY_ENABLED=false
GUARDRAIL_PROMPT_INJECTION_ENABLED=false

# ── 8. RAG & VECTOR SEARCH ────────────────────────────────────────────────────
QDRANT_URL=:memory:                       # :memory: for local, or http://localhost:6333
RAG_DEFAULT_CHUNK_SIZE=500
RAG_DEFAULT_CHUNK_OVERLAP=50

# ── 9. OBSERVABILITY & TELEMETRY ──────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SLACK_WEBHOOK_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=              # e.g. http://localhost:4318
