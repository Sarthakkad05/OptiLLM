# =============================================================================
# OptiLLM Gateway — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local development — zero config):
DATABASE_URL=sqlite:///./optillm.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://optillm:password@localhost:5432/optillmdb

# ── Redis ─────────────────────────────────────────────────────────────────────
# Leave empty to disable distributed cache (falls back to in-memory FAISS only)
REDIS_URL=                   # e.g. redis://localhost:6379/0

# ── LLM Provider API Keys ─────────────────────────────────────────────────────
OPENAI_API_KEY=              # sk-proj-...
ANTHROPIC_API_KEY=           # sk-ant-...
GEMINI_API_KEY=              # AI... from Google AI Studio

# ── Ollama (Local / Self-hosted) ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434   # Leave as-is if running locally

# ── Default Provider & Model ──────────────────────────────────────────────────
DEFAULT_PROVIDER=openai      # openai | gemini | anthropic | ollama
DEFAULT_MODEL=gpt-4o         # Default model for unspecified requests

# ── Request Timeout ───────────────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=60.0

# ── Authentication ────────────────────────────────────────────────────────────
API_KEY_AUTH_ENABLED=false   # Set to true in production
# Comma-separated allowed API keys (used when API_KEY_AUTH_ENABLED=true)
OPTILLM_API_KEYS=sk-optillm-dev-key-change-this-in-prod

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Allowed Providers & Models ────────────────────────────────────────────────
ALLOWED_PROVIDERS=openai,gemini,anthropic,ollama
ALLOWED_MODELS=*             # * = all models, or comma-separated list

# ── Semantic Cache ────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=86400      # 24 hours
CACHE_NAMESPACE=default
CACHE_SIMILARITY_THRESHOLD=0.90

# ── Routing ───────────────────────────────────────────────────────────────────
ROUTING_STRATEGY=cost_optimized     # cost_optimized | round_robin | least_latency
ROUTING_MODE=shadow                 # rule_based | ai | shadow

# ── Circuit Breaker ───────────────────────────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIME=30.0

# ── AI Router ────────────────────────────────────────────────────────────────
AI_ROUTER_CONFIDENCE_THRESHOLD=0.70
AI_ROUTER_MODEL_PATH=ai_router.joblib

# ── RAG ───────────────────────────────────────────────────────────────────────
QDRANT_URL=:memory:          # :memory: for local, or http://localhost:6333
RAG_DEFAULT_CHUNK_SIZE=500
RAG_DEFAULT_CHUNK_OVERLAP=50

# ── Storage ───────────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=faiss_store/index.faiss

# ── GitHub (optional — for repository metadata in MCP tools) ─────────────────
# GITHUB_REPO_URL=https://github.com/your-org/your-repo.git
